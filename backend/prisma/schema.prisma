// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int              @id @default(autoincrement())
  name        String?
  email       String           @unique
  password    String
  workspace   Workspace?       @relation(fields: [work_id], references: [id])
  group       Group?           @relation(fields: [group_id], references: [id])
  group_id    Int?
  work_id     Int?
  createdTask Task[]           @relation("TaskCreator")
  assignments TaskAssignment[]
  created_at  DateTime         @default(now())
}

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  user        User[]
  group       Group[]
  task        Task[]
  tags        String?
  description String?
  created_at  DateTime @default(now())
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  task        Task[]
  user        User[]
  workspace   Workspace @relation(fields: [work_id], references: [id])
  work_id     Int
  createdAt   DateTime  @default(now())
}

model Task {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  dueDate     DateTime? // Made optional and renamed for consistency
  priority    Priority  @default(NORMAL)

  // Group relationship (required - every task must be in a group)
  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Workspace relationship (for easier querying)
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Creator relationship (optional)
  createdById Int?
  createdBy   User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Assignments
  assignments TaskAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([priority])
  @@index([dueDate])
}

model TaskAssignment {
  id     Int   @id @default(autoincrement())
  taskId Int
  userId Int
  task   Task  @relation(fields: [taskId], references: [id])
  user   User  @relation(fields: [userId], references: [id])
  role   Roles @default(ASSIGNEE)
}

enum Priority {
  HIGH
  NORMAL // Default
  LOW
}

enum Roles {
  ASSIGNEE
  REVIEWER
}
