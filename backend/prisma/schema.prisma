generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ==================== USER ====================
//

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String

  // Workspace membership
  workspaceMembers WorkspaceMember[]

  // Group membership
  groupMembers GroupMember[]

  // Task interactions
  createdTasks   Task[]           @relation("TaskCreator")
  assignments    TaskAssignment[]
  followers      TaskFollower[]
  taskActivities TaskActivity[]

  createdAt DateTime @default(now())
}

//
// ==================== WORKSPACE ====================
//

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  tags        String?
  createdAt   DateTime @default(now())

  // Relations
  members WorkspaceMember[]
  groups  Group[]           @relation("WorkspaceGroups")
  tasks   Task[]
}

//
// ==================== WORKSPACE MEMBER ====================
//

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

//
// ==================== GROUP ====================
//

model Group {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  workId      Int

  workspace Workspace     @relation("WorkspaceGroups", fields: [workId], references: [id], onDelete: Cascade)
  tasks     Task[]
  members   GroupMember[]

  createdAt DateTime @default(now())
}

//
// ==================== GROUP MEMBER ====================
//

model GroupMember {
  id      Int @id @default(autoincrement())
  groupId Int
  userId  Int

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

//
// ==================== TASK ====================
//

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  groupId     Int
  workspaceId Int
  createdById Int?

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  assignments  TaskAssignment[]
  followers    TaskFollower[]
  activityLogs TaskActivity[]

  @@index([groupId])
  @@index([workspaceId])
  @@index([priority])
  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

//
// ==================== TASK ASSIGNMENT ====================
//

model TaskAssignment {
  id     Int            @id @default(autoincrement())
  taskId Int
  userId Int
  role   AssignmentRole @default(ASSIGNEE)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

enum AssignmentRole {
  ASSIGNEE
  REVIEWER
  WATCHER
}

//
// ==================== TASK FOLLOWER ====================
//

model TaskFollower {
  id     Int @id @default(autoincrement())
  taskId Int
  userId Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

//
// ==================== TASK ACTIVITY LOG ====================
//

model TaskActivity {
  id        Int          @id @default(autoincrement())
  taskId    Int
  userId    Int?
  action    ActivityType
  detail    String?
  createdAt DateTime     @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  COMMENT
  ASSIGNED
  UNASSIGNED
  MOVED
}
